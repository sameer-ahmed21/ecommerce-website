# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file — it's already git-ignored.

# MongoDB connection string (MongoDB Atlas or local)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ecommerce
MONGODB_URI=

PORT=5000

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used once by `npm run seed:admin` to create/promote the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
